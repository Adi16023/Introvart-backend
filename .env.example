DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
PORT=4000
# Public API URL, used for media links (Render sets RENDER_EXTERNAL_URL automatically).
API_PUBLIC_URL=http://localhost:4000
# JWT keys should be copied from the existing StaffSigningKey record into deployment secrets before removing that table.
STAFF_JWT_PRIVATE_KEY=
STAFF_JWT_PUBLIC_KEY=
# Comma-separated storefront/portal origins. Empty allows any origin for local work.
CORS_ORIGINS=
# S3-compatible storage credentials.
S3_BUCKET=products
AWS_ENDPOINT_URL_S3=https://YOUR-ENDPOINT
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
# Cashfree payments. Use sandbox keys while testing; set CASHFREE_ENV=production with live keys to go live.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Public address of the storefront (no trailing slash); shoppers return here after paying.
FRONTEND_URL=http://localhost:3000
VELOCITY_API_KEY=
# Defaults to production. Obtain a confirmed staging URL and separate credentials before testing live calls.
VELOCITY_API_BASE_URL=https://shazam.velocity.in
# Pickup warehouses are configured in Admin > Shipping or Creator > Shipping, not in frontend variables.
