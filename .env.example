DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
PORT=4000
# Public base URL of this API, used to build media links (Render sets RENDER_EXTERNAL_URL automatically)
API_PUBLIC_URL=http://localhost:4000
# Required in production: shared secret for the creator, admin and fulfil surfaces
STAFF_API_KEY=
# Comma separated storefront/portal origins allowed by CORS (empty = any, for local work)
CORS_ORIGINS=
# S3-compatible bucket (Neon storage)
S3_BUCKET=products
AWS_ENDPOINT_URL_S3=https://YOUR-ENDPOINT
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
